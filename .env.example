# Local-developer environment variables for the SPAN simulator.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way — it holds
# a live access token.
#
# Two things read this one file, so there is a single copy rather than several
# drifting apart:
#   - direnv, via `dotenv_if_exists` in .envrc (shell sessions, pytest)
#   - scripts/run-local.sh, which sources it before applying its own defaults, so a
#     value already exported in your shell still wins
#
# Home Assistant, used by the simulator's HA API calls and integration tests. Both
# are optional: omit them and the simulator runs without touching HA.
#
# HA_TOKEN is handed to the simulator through the ENVIRONMENT, never as a
# --ha-token flag. Command-line arguments are visible to any process listing on the
# machine, so a token passed that way is readable by anything running as your user.
# run-local.sh exports these instead of forwarding them, and __main__.py already
# defaults --ha-url / --ha-token from the environment, so the flags bought nothing
# but exposure.
HA_URL=https://homeassistant.example:8123
HA_TOKEN=

# EBUS_EMITTER_PATH is obsolete. The emitter is vendored under
# `src/panelbench/ebus_emitter` and every dependency resolves from PyPI,
# so nothing reads it. Safe to delete from any .env that still carries it.
