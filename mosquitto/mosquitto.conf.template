# Mosquitto configuration for SPAN eBus simulator
# Certificate paths are substituted at container startup

# MQTTS listener (TLS over TCP)
listener 18883
cafile /app/certs/ca.crt
certfile /app/certs/server.crt
keyfile /app/certs/server.key
require_certificate false

# WebSocket listener (plain)
listener 19001
protocol websockets

# WebSocket listener (TLS)
listener 19002
protocol websockets
cafile /app/certs/ca.crt
certfile /app/certs/server.crt
keyfile /app/certs/server.key
require_certificate false

# Authentication
allow_anonymous false
password_file /app/mosquitto/passwd

# Persistence
persistence true
persistence_location /mosquitto/data/

# Client queue
# One subscription to ebus/5/# receives every panel's retained tree at once.
# Mosquitto's default of 1000 queued messages per client drops the excess over
# a real network, so the limit is lifted.
max_queued_messages 0

# Logging
log_dest stdout
log_type warning
log_type error
log_type notice
